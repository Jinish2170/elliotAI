# elliotAI Backend Environment Variables Template
# Copy this file to elliot/.env and fill in your values

# ========================================
# NVIDIA NIM Configuration
# ========================================
NVIDIA_NIM_API_KEY=your_nvidia_api_key_here
NVIDIA_NIM_ENDPOINT=https://integrate.api.nvidia.com/v1
# Verified 2026-11; the older Llama 3.x NIM endpoints return HTTP 410 (retired).
NIM_VISION_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
NIM_VISION_FALLBACK=mistralai/mistral-large-4-1t-a52b
NIM_LLM_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
# Reasoning models return empty answers at small max_tokens unless thinking is off
NIM_DISABLE_THINKING=true
NIM_TIMEOUT=90
NIM_RETRY_COUNT=4
NIM_REQUESTS_PER_MINUTE=40

# ========================================
# Observability (optional)
# ========================================
# Export OpenTelemetry traces to Phoenix (local or Phoenix Cloud)
# PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006
# PHOENIX_API_KEY=
# PHOENIX_PROJECT_NAME=elliotai
# Local JSONL traces (default on) and cost accounting (USD per 1M tokens)
# ELLIOT_TRACE_LOCAL=true
# NIM_PRICE_INPUT_PER_1M=0
# NIM_PRICE_OUTPUT_PER_1M=0

# ========================================
# External Search APIs
# ========================================
TAVILY_API_KEY=your_tavily_api_key_here
TAVILY_REQUESTS_PER_MINUTE=5

# ========================================
# OSINT / CTI APIs
# ========================================
URLVOID_API_KEY=your_urlvoid_api_key_here
URLVOID_REQUESTS_PER_MINUTE=20
ABUSEIPDB_API_KEY=your_abuseipdb_api_key_here
ABUSEIPDB_REQUESTS_PER_MINUTE=15
GOOGLE_SAFE_BROWSING_KEY=your_google_safe_browsing_key_here

# ========================================
# Database
# ========================================
USE_DB_PERSISTENCE=true

# ========================================
# Browser Settings
# ========================================
BROWSER_HEADLESS=true
BROWSER_VIEWPORT_WIDTH=1920
BROWSER_VIEWPORT_HEIGHT=1080
MOBILE_VIEWPORT_WIDTH=390
MOBILE_VIEWPORT_HEIGHT=844

# ========================================
# Audit Configuration
# ========================================
DEFAULT_AUDIT_TIER=standard_audit
DEFAULT_VERDICT_MODE=expert
MAX_ITERATIONS=5
MAX_PAGES_PER_AUDIT=10

# ========================================
# Security Settings
# ========================================
ENABLED_SECURITY_MODULES=security_headers,phishing_db,tls_ssl,csp,gdpr,pci_dss,cookies,dom_analyzer,js_analysis,redirect_chain
USE_SECURITY_AGENT=true
SECURITY_AGENT_ROLLOUT=1.0

# ========================================
# CORS (Backend)
# ========================================
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:3000